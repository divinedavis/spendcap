# Configuration for private npm package dependencies
# For more information on using private registries with Edge Functions, see:
# https://supabase.com/docs/guides/functions/import-maps#importing-from-private-registries

# Refuse a package version published in the last week.
#
# Deno/npm resolution here happens at deploy time, so a compromised maintainer
# account publishing a malicious patch release lands in the next function
# deploy. Those releases are typically yanked within hours of being noticed;
# a week's delay steps over that window without pinning every dependency.
minimum-release-age=10080
