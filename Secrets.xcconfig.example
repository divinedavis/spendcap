// Copy this file to Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is gitignored. The anon key is a public client
// credential protected by RLS — it's kept out of git only so the
// repo stays portable and the key can be rotated without a code change.

SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here

// Google sign-in. Both come from the same iOS OAuth client in the Google
// Cloud console (APIs & Services > Credentials > Create credentials >
// OAuth client ID > iOS). Neither is a secret — an iOS OAuth client has no
// client secret and both values ship inside the app bundle — but they live
// here so the repo stays portable.
//
// Leave them unset and the app builds fine with the Google button hidden;
// Apple sign-in and email are unaffected.
//
// REVERSED is the CLIENT_ID's dot-components in reverse, which is exactly
// what the console shows as "iOS URL scheme". Don't hand-reverse it.
//
// GOOGLE_REVERSED_CLIENT_ID must never be *empty*: it becomes a
// CFBundleURLSchemes entry, and an empty scheme fails App Store validation
// at upload. If you aren't using Google, set it to com.divinedavis.spendcap.
GOOGLE_CLIENT_ID = 000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
